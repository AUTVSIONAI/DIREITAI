{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm install --force && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --force",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://direitai-backend.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}